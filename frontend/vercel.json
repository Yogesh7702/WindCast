{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://windcast-api.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://windcast-api.onrender.com/docs"
    }
  ]
}
