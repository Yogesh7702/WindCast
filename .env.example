# --- Backend -----------------------------------------------------------------
# Directory holding the CSV snapshot (inside the container: /app/data/snapshot)
DATA_DIR=./data/snapshot
# Installed GB wind capacity, used to express MAE as % of capacity
WIND_CAPACITY_MW=30000
# Indicative economics for the exposure calculator (£/MWh)
DA_PRICE_GBP_MWH=85
BALANCING_COST_GBP_MWH=120
# Placeholder national demand level (GW-scale, user editable in the UI)
BASE_DEMAND_MW=38000
# Comma-separated allow-list for CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Frontend ----------------------------------------------------------------
# Leave empty to use the same-origin "/api" prefix (nginx/vite proxy).
# For a split deployment (UI on Vercel, API elsewhere) set the absolute URL:
# VITE_API_BASE=https://windcast-api.onrender.com/api
VITE_API_BASE=
